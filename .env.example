# 개발 시 vite proxy 사용: 비워두면 /api 요청이 VITE_API_PROXY_TARGET으로 프록시됩니다.
# 프로덕션 빌드 시에는 백엔드 URL을 직접 지정하세요.
VITE_API_BASE_URL=

# vite dev server proxy target (기본값: http://localhost:8080)
VITE_API_PROXY_TARGET=http://localhost:8080

# 달력 ID (기본값: 1)
VITE_CALENDAR_ID=1

# 인증 토큰 (필요한 경우 설정)
# VITE_API_TOKEN=
